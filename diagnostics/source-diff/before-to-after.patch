+    const int imax = field.imax, jmax = field.jmax, kmax = field.kmax;
+    fpvec3 staggeredCoord = mapWorldToStaggered(walkerPosition, domainOrigin, domainExtent, imax, jmax, kmax) - fpvec3(1, 0.5, 1);
