-    for (int i = 1; i <= imax; i++) {
-        for (int k = 1; k <= kmax; k++) {
-            // Down wall
-            if (isNoSlip(Flag[IDXFLAG(i,0,k)])) {
-                U[IDXU(i,0,k)] = -U[IDXU(i,1,k)];
-                V[IDXV(i,0,k)] = 0.0;
-                W[IDXW(i,0,k)] = -W[IDXW(i,1,k)];
