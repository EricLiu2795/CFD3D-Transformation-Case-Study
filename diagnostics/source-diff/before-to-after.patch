-                T[IDXT(i,jmax+1,k)] = 2 * T_h - T[IDXT(i,jmax,k)];
-            } else if (isCold(Flag[IDXFLAG(i,jmax+1,k)])) {
-                T[IDXT(i,jmax+1,k)] = 2 * T_c - T[IDXT(i,jmax,k)];
-            } else {
-                T[IDXT(i,jmax+1,k)] = T[IDXT(i,jmax,k)];
-            }
-        }
-    }
-}
