-
-            // Up wall
-            if (isNoSlip(Flag[IDXFLAG(i,jmax+1,k)])) {
-                U[IDXU(i,jmax+1,k)] = -U[IDXU(i,jmax,k)];
-                V[IDXV(i,jmax,k)] = 0.0;
-                W[IDXW(i,jmax+1,k)] = -W[IDXW(i,jmax,k)];
