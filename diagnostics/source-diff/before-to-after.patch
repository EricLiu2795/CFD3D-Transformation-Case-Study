+template<class InputIterator>
+void tokenizeBySpace(const std::string &inputText, InputIterator& outputList) {
+    std::string buffer;
+    for (char c : inputText) {
+        if (c != ' ' && c != '\t') {
+            buffer += c;
+        } else {
+            if (buffer.length() > 0) {
+                outputList.push_back(buffer);
+                buffer = "";
+            }
+        }
+    }
+    if (buffer.length() > 0) {
+        outputList.push_back(buffer);
+        buffer = "";
+    }
+}
