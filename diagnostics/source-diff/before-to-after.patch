-                    T[IDXT(i, j, k)] = T_temp[IDXT(i, j, k)] + dt * (
-                            (1 / (Re*Pr))*(d2T_dx2 + d2T_dy2 + d2T_dz2) -
-                            duT_dx -
-                            dvT_dy -
