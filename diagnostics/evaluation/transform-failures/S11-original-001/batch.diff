 #include "CfdSolver/serial/momentum_eqs.hpp"
 #include "CfdSolver/cell_flags.hpp"
 
+static Real donorCellFlux(Real D, Real conv_hi, Real val_hi, Real conv_lo, Real val_lo,
+        Real diff_hi, Real diff_lo, Real alpha) {
+    return Real(0.25)*D*(
+            conv_hi*val_hi - conv_lo*val_lo +
+            alpha*(
+                    std::abs(conv_hi)*diff_hi - std::abs(conv_lo)*diff_lo
+            )
+    );
+}
+
+static Real advectTemperature(Real d, Real vel_c, Real vel_m, Real T_m, Real T_c, Real T_p, Real alpha) {
+    return 1 / d * (
+            vel_c * ((T_c + T_p) / 2) -
+            vel_m * ((T_m + T_c) / 2) +
+            alpha * (
+                    std::abs(vel_c)*((T_c - T_p) / 2) -
+                    std::abs(vel_m)*((T_m - T_c) / 2)
+            )
+    );
+}
