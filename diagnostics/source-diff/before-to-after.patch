-void setInternalVBoundariesCpp(
-        int imax, int jmax, int kmax,
-        Real *V,
-        FlagType *Flag) {
-    #pragma omp parallel for
-    for (int i = 1; i <= imax; i++) {
-        for (int j = 1; j <= jmax-1; j++) {
-            for (int k = 1; k <= kmax; k++) {
-                int U_check = 0;
-                int D_check = 0;
-                int U1_check = 0;
-                int D1_check = 0;
-
-                if (!isFluid(Flag[IDXFLAG(i, j, k)])) {
-                    if (B_U(Flag[IDXFLAG(i, j, k)])) {
