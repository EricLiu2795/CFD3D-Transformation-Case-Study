-        if (!rayBoxPlaneIntersection(rayOrigin[i], rayDirection[i], lower[i], upper[i], tNear, tFar)) {
-            return false;
-        }
-    }
-
-    //entrancePoint = rayOrigin + tNear * rayDirection;
-    //exitPoint = rayOrigin + tFar * rayDirection;
