-    shared(imax, jmax, kmax, dx, dy, dz, dt, Re, Pr, alpha, U, V, W, T, T_temp, Flag)
-    for (int i = 1; i <= imax; i++) {
-        for (int j = 1; j <= jmax; j++) {
